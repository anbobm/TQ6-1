@page
@model GameModel

<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/style.css">
        <script type="module" src="/js/app.js"></script>
        <title>Not Kniffel</title>
    </head>
    <body>
        <main>
            <section class="scoresheet-grid">
                @foreach(var scoreSheet in Model.Game.ScoreSheets){
                <table @if(Model.Game.ActiveScoreSheet.Id == scoreSheet.Id){<text>id="activeTable" class="active-table"</text>}>
                        <caption>@scoreSheet.Player.Name</caption>
                        <tr>
                            <td>⚀ ⚀ ⚀</td>
                            <td class="right-align">@scoreSheet.Ones</td>
                        </tr>
                        <tr>
                            <td>⚁ ⚁ ⚁</td>
                            <td class="right-align">@scoreSheet.Twos</td>
                        </tr>
                        <tr>
                            <td>⚂ ⚂ ⚂</td>
                            <td class="right-align">@scoreSheet.Threes</td>
                        </tr>
                        <tr>
                            <td>⚃ ⚃ ⚃</td>
                            <td class="right-align">@scoreSheet.Fours</td>
                        </tr>
                         <tr>
                            <td>⚄ ⚄ ⚄</td>
                            <td class="right-align">@scoreSheet.Fives</td>
                        </tr>
                        <tr>
                            <td>⚅ ⚅ ⚅</td>
                            <td class="right-align">@scoreSheet.Sixes</td>
                        </tr>
                        <tr>
                            <td>Oberer Teil</td>
                            <td class="right-align">@scoreSheet.ScoreTopPart()</td>
                        </tr>
                         <tr>
                            <td>Bonus Oben</td>
                            <td class="right-align">@scoreSheet.TopPartBonus(@scoreSheet.ScoreTopPart())</td>
                        </tr>
                        <tr>
                            <td>Dreierpasch</td>
                            <td class="right-align">@scoreSheet.ThreeOfAKind</td>
                        </tr>
                        <tr>
                            <td>Viererpasch</td>
                            <td class="right-align">@scoreSheet.FourOfAKind</td>
                        </tr>
                        <tr>
                            <td>FullHouse</td>
                            <td class="right-align">@scoreSheet.FullHouse</td>
                        </tr>
                        <tr>
                            <td>Kleine Str.</td>
                            <td class="right-align">@scoreSheet.Straight</td>
                        </tr>
                        <tr>
                            <td>Große Str.</td>
                            <td class="right-align">@scoreSheet.LongStraight</td>
                        </tr>
                        <tr>
                            <td>Knifelus</td>
                            <td class="right-align">@scoreSheet.FiveOfAKind</td>
                        </tr>
                        <tr>
                            <td>Chance</td>
                            <td class="right-align">@scoreSheet.Chance</td>
                        </tr>
                        <tr>
                            <td>Punkte Unten</td>
                            <td class="right-align">@scoreSheet.ScoreBottomPart()</td>
                        </tr>
                        <tr>
                            <td>Punkte Gesamt</td>
                            <td class="right-align">@scoreSheet.ScoreTotal()</td>
                        </tr>
                    </table>
                }
            </section>
            <section>
                <h2>Am Zug: @Model.Game.ActiveScoreSheet.Player.Name</h2>
                <p>Verbleibende Versuche: @(3 - Model.Action.Rolls.Count)</p>
                @if(Model.Action.Rolls.Count > 0){
                    <div id="rollDiv">
                        @foreach(int roll in Model.Action.Rolls[Model.Action.Rolls.Count-1]){
                            <span>@Dice.GetSymbol(roll)</span>
                        }
                    </div>
                }
                <form method = "post" action = "/Game">
                    @Html.AntiForgeryToken()
                    <input id="actionInput" name="actionInput" value="@Model.ActionJson" class="hidden">
                    <button id="actionButton">Würfeln</button>
                </form>
            </section>
        </main>
        @if(!Model.Game.OnGoing){
            <div class="overlay">
                <h2>Spiel beendet</h2>
                <ol>
                    @foreach(var scoreSheet in Model.Game.Ranking()){
                        <li>@scoreSheet.Player.Name @scoreSheet.ScoreTotal()</li>
                    }
                </ol>
                <p><a href="Index">Hauptmenü</a></p>
            </div>
        }
    </body>
</html>
