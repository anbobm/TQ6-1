@page
@model IndexModel
@{
    var name = "Paul";
    var alter = 35;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Webapp</title>
</head>
<body>
    <h1>Webapp</h1>
    <p>Ich bin @name und bin @alter Jahre alt.</p>
    <p>Foo: @Model.Foo</p>
    <form action="/Greeting" method="get">
        <input type="text" name="name">
        <input type="text" name="alter">
        <input type="submit" value="Begrüßen">
    </form>
</body>
</html>