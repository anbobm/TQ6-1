@page

<style>
    table {
        border-collapse: collapse;
        width: 100%;
        table-layout: fixed;
    }

    td {
        border: 1px black solid;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<table>
    <tr>
        <th>Key</th>
        <th>Value</th>
    </tr>
    @foreach (var cookie in Request.Cookies) {
        <tr>
            <td>@cookie.Key</td>
            <td>@cookie.Value</td>
        </tr>
    }
</table>