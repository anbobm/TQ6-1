@page
@model RazorApp.Pages.SetCookieModel

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <title>Cookie setzen</title>
</head>
<body>
    <h1>Cookie setzen</h1>

    <form method="post">
        @Html.AntiForgeryToken()
        <label for="cookieValue">Neuer Wert für Cookie:</label>
        <input type="text" id="cookieValue" name="CookieValue" />
        <button type="submit">Speichern</button>
    </form>
</body>
</html>
