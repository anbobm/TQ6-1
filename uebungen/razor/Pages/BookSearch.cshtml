@page
@model BookSearchModel

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Booksearch</title>
  </head>
  <body>
    <main>
        <section>
            <fieldset>
                <legend>Suche ein Buch</legend>
                <form>
                    <label>Suchbegriff
                        <input name="queryInput" placeholder="Suchbegriff">
                    </label>
                    <button>Suche</button>
                </form>
            </fieldset>
            <table>
                @foreach(var book in Model.Books){
                    <tr>
                        <td>@book.Id</td>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Pages</td>
                    </tr>
                }
            </table>
        </section>
    </main>
  </body>
</html>
